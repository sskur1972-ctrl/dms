                                           @*  <a class="btn btn-primary btn-label waves-effect waves-light rounded-pill" asp-controller="Account" asp-action="NotificationIndex"><i class="ri-user-smile-line label-icon align-middle rounded-pill fs-16 me-2"></i>Back To List</a>
 *@

                                        </div>

                                    </div><!--end col-->

                                </div><!--end row-->
                            </form>
  

                        </div>
                    </div>
                </div>
            </div>

<script src="~/assets/js/pages/form-validation.init.js"></script>

