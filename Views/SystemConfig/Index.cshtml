@using DMS.Model.Master
@model List<SystemConfigItem>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["PageTitle"] = "System Configuration";
    var categories = ViewBag.categories as List<string> ?? new List<string>();
    string? category = ViewBag.category as string;
}
<partial name="_DataTableCSS" />
<partial name="_AdminPageTitle" />

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header border-0">
                <div class="row g-3 align-items-center">
                    <div class="col-sm-auto">
                        <ul class="nav nav-pills flex-wrap">
                            <li class="nav-item"><a class="nav-link @(string.IsNullOrEmpty(category) ? "active" : "")" asp-action="Index">All</a></li>
                            @foreach (var c in categories)
                            {
                                <li class="nav-item"><a class="nav-link text-capitalize @(category == c ? "active" : "")" asp-action="Index" asp-route-category="@c">@c</a></li>
                            }
                        </ul>
                    </div>
                    <div class="col-sm text-muted small text-end">GxP-relevant settings need a reason for change. Secret values are never shown.</div>
                </div>
            </div>
            <div class="card-body">
                <table id="assetlist" class="table dt-responsive align-middle table-hover table-bordered" style="width:100%">
                    <thead class="table-light">
                        <tr>
                            <th>Category</th>
                            <th>Key</th>
                            <th>Value</th>
                            <th>Type</th>
                            <th>GxP</th>
                            <th>Last Changed</th>
                            <th width="5%" class="not-export-col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in Model)
                        {
                            <tr>
                                <td class="text-capitalize">@i.category</td>
                                <td><code>@i.config_key</code><br /><small class="text-muted">@i.description</small></td>
                                <td style="max-width: 360px; word-break: break-all;">
                                    @if (i.IsSecret) { <span class="text-muted">@(string.IsNullOrEmpty(i.config_value) ? "(not set)" : "••••••••")</span> }
                                    else { @i.config_value }
                                </td>
                                <td>@i.value_type</td>
                                <td>@(i.is_gxp_relevant ? "Yes" : "")</td>
                                <td>@i.updated_by_name<br /><small class="text-muted">@i.updated_at?.ToString("dd-MMM-yyyy HH:mm")</small></td>
                                <td><center><a class="btn btn-soft-secondary btn-sm" asp-action="Edit" asp-route-key="@i.config_key" title="Change"><i class="ri-pencil-fill"></i></a></center></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<partial name="_AdminTableJS" />
<script>
    document.addEventListener('DOMContentLoaded', function () { initAdminTable('#assetlist', [0, 1, 3, 4, 5], [[0, 'asc'], [1, 'asc']]); });
</script>
