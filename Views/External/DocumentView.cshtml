@model DMS.Web.Controllers.ExternalDocumentViewModel
@{
    Layout = null;
    var revision = string.IsNullOrWhiteSpace(Model.Revision) ? "—" : Model.Revision;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>@Model.DocumentNumber — view only</title>
    <style>
        html, body { height: 100%; margin: 0; font-family: "Segoe UI", Arial, sans-serif; color: #1f2937; }
        body { display: flex; flex-direction: column; background: #eef1f5; }
        header { display: flex; flex-wrap: wrap; gap: 6px 20px; align-items: baseline; padding: 11px 18px; color: #fff; background: #0f5132; }
        header strong { font-size: 16px; }
        header span { font-size: 13px; }
        .viewer { flex: 1; min-height: 0; }
        iframe { display: block; width: 100%; height: 100%; border: 0; background: #fff; }
        @@media print { body { display: none !important; } }
    </style>
</head>
<body oncontextmenu="return false">
    <header>
        <strong>@Model.DocumentNumber</strong>
        <span>@Model.Title</span>
        <span>Revision @revision</span>
        <span>@Model.State@(Model.EffectiveFrom == null ? "" : " · effective from " + Model.EffectiveFrom.Value.ToString("dd-MMM-yyyy"))</span>
        <span>View only</span>
    </header>
    <main class="viewer">
        <iframe src="@Model.PdfUrl#toolbar=0&amp;navpanes=0&amp;view=FitH" title="@Model.DocumentNumber"></iframe>
    </main>
    <script>
        document.addEventListener("keydown", function (event) {
            if ((event.ctrlKey || event.metaKey) && ["p", "s"].includes(event.key.toLowerCase())) {
                event.preventDefault();
                event.stopPropagation();
            }
        }, true);
    </script>
</body>
</html>
