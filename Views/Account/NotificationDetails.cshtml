@model UserNotificationViewModel


@using Excise.Model.Account;
@using Excise.Web.Services;
@using Newtonsoft.Json;
@{
    List<string> permissions = null;
    string _permissionList = string.Empty;

    string username = "";
    string rolename = "";
    string displayname = "";
    string actionName = string.Empty;
    int PermissionCount = 0;
   

}

@{
    try
    {
        @if (User.Identity.IsAuthenticated)
        {
            var claimsCount = User.Claims.Count();

            if (claimsCount > 0)
            {
                // Retrieve the custom claim value from the user's claims
                username = User.Identity.Name;
                displayname = User.Claims.FirstOrDefault(c => c.Type == "displayName")?.Value;
                rolename = User.Claims.FirstOrDefault(c => c.Type == "Roles_Name")?.Value;
                _permissionList = User.Claims.FirstOrDefault(c => c.Type == "serializedPermissionList")?.Value;
            }
        }

    }
    catch (Exception ex)
    {
        displayname = ex.Message;
    }
}




