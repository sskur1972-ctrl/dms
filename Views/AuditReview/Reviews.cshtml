@using DMS.Model.Documents
@model List<AuditReviewRow>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["PageTitle"] = "Audit Trail Reviews";
    ViewData["Section"] = "Compliance";
}
<partial name="_AdminPageTitle" />

<div class="card">
    <div class="card-header d-flex align-items-center">
        <h5 class="card-title mb-0 flex-grow-1">Recorded reviews</h5>
        @if (ViewBag.canReview == true) { <a class="btn btn-sm btn-primary" asp-action="Review"><i class="ri-quill-pen-line"></i> Record a periodic review</a> }
        <a class="btn btn-sm btn-light ms-2" asp-action="Index">Search the trail</a>
    </div>
    <div class="card-body">
        <p class="small text-muted">EU GMP Annex 11 cl. 9: the audit trail is reviewed regularly. Each review records the period and filter, how many entries it covered,
            a fresh check of the hash chain, the findings and who reviewed (password re-entered). Reviews cannot be changed or deleted.</p>
        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle small mb-0">
                <thead class="table-light"><tr><th>#</th><th>Type</th><th>Period (UTC)</th><th>Filter</th><th>Entries</th><th>Hash chain</th><th>Findings</th><th>Reviewed by</th></tr></thead>
                <tbody>
                    @if (Model.Count == 0) { <tr><td colspan="8" class="text-center text-muted py-3">No review recorded yet.</td></tr> }
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.id</td><td>@r.review_type</td>
                            <td class="text-nowrap">@r.period_from?.ToString("dd-MMM-yyyy HH:mm") → @r.period_to?.ToString("dd-MMM-yyyy HH:mm")</td>
                            <td class="font-monospace" style="max-width:240px">@r.filter_json</td>
                            <td>@r.row_count.ToString("N0")</td>
                            <td>@if (r.chain_verified == true) { <span class="badge bg-success">verified</span> } else { <span class="badge bg-danger">BROKEN at #@r.chain_break_at_id</span> }</td>
                            <td style="white-space:pre-wrap">@r.findings</td>
                            <td class="text-nowrap">@r.reviewed_by_name<div class="text-muted">@r.reviewed_at.ToString("dd-MMM-yyyy HH:mm") UTC</div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
