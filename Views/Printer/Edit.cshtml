@using DMS.Model.Master
@model Printer
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["PageTitle"] = Model.id > 0 ? "Edit Printer" : "Add Printer";
}
<partial name="_AdminPageTitle" />

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-header"><h4 class="card-title mb-0">@ViewData["PageTitle"]</h4></div>
            <div class="alert alert-warning py-2 m-3 mb-0" role="alert" style="font-size: 14px;">
                ⚠ Fields marked <span style="color: red;">*</span> are required. The printer name must match the name of the printer on the print server.
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post" class="row g-3">
                    <input type="hidden" asp-for="id" />
                    <input type="hidden" asp-for="is_active" />
                    <div class="form-group col-xl-6 mb-3">
                        <label asp-for="printer_name" class="form-label"></label> <span style="color: red;">*</span>
                        <input asp-for="printer_name" class="form-control" required maxlength="128" autocomplete="off" />
                        <span asp-validation-for="printer_name" class="text-danger"></span>
                    </div>
                    <div class="form-group col-xl-3 mb-3">
                        <label asp-for="ip_address" class="form-label"></label>
                        <input asp-for="ip_address" class="form-control" maxlength="45" placeholder="e.g. 10.0.0.25" autocomplete="off" />
                        <span asp-validation-for="ip_address" class="text-danger"></span>
                    </div>
                    <div class="form-group col-xl-9 mb-3">
                        <label asp-for="location" class="form-label"></label>
                        <input asp-for="location" class="form-control" maxlength="128" autocomplete="off" />
                        <span asp-validation-for="location" class="text-danger"></span>
                    </div>
                    <div class="form-group col-xl-3 mb-3">
                        <label asp-for="display_order" class="form-label"></label>
                        <input asp-for="display_order" class="form-control" type="number" autocomplete="off" />
                        <span asp-validation-for="display_order" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <div class="text-end">
                            <a asp-action="Index" class="btn btn-primary ms-2">Back To List</a>
                            <button type="submit" class="btn btn-success">Save</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
