@using DMS.Web.Services.Intelligence
@model KnowledgeSource
@{ViewData["PageTitle"]="Reference preview";Layout="~/Views/Shared/_Layout.cshtml";}
<partial name="_AdminPageTitle" />
<div class="card"><div class="card-body"><h5>@Model.Title</h5><p>Status: @(Model.Active?"Active":"Inactive") · Source SHA-256: @Model.Sha</p>
<pre style="white-space:pre-wrap;max-height:65vh;overflow:auto">@Model.Body</pre>
@if(Model.Uri!=null){<a href="@Model.Uri" target="_blank" rel="noopener noreferrer">Source reference</a>}
<form asp-action="ReferenceStatus" method="post" class="mt-3"><input name="id" type="hidden" value="@Model.Id" /><input name="active" type="hidden" value="@((!Model.Active).ToString().ToLowerInvariant())" /><button class="btn btn-primary">@(Model.Active?"Deactivate reference":"Activate approved reference")</button> <a class="btn btn-light" asp-action="References">Back</a></form>
</div></div>
