@using DMS.Model.Documents
@model List<CopyToRetrieveRow>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["PageTitle"] = "Copies to Retrieve";
    ViewData["Section"] = "Controlled Print";
}
<partial name="_AdminPageTitle" />

<div class="card">
    <div class="card-body">
        <p class="small text-muted">Controlled copies still issued although their revision has been superseded or made obsolete, or whose return date has passed.
            Collect them and record the return or destruction on the print request.</p>
        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle mb-0">
                <thead class="table-light"><tr><th>Copy</th><th>Document</th><th>Rev</th><th>Issued to</th><th>Issued</th><th>Return by</th><th>Why</th><th>Request</th></tr></thead>
                <tbody>
                    @if (Model.Count == 0) { <tr><td colspan="8" class="text-center text-muted py-3">Nothing to retrieve.</td></tr> }
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="font-monospace">@c.copy_control_number</td>
                            <td><a asp-controller="Documents" asp-action="Details" asp-route-id="@c.document_id">@c.document_number</a><div class="small text-muted">@c.title</div></td>
                            <td>@c.version_no</td>
                            <td>@c.issued_to_name</td>
                            <td class="small">@c.issued_at?.ToString("dd-MMM-yyyy")</td>
                            <td class="small">@c.return_due_on?.ToString("dd-MMM-yyyy")</td>
                            <td><span class="badge @(c.reason == "Return date passed" ? "bg-warning text-dark" : "bg-danger")">@c.reason</span></td>
                            <td><a asp-action="Details" asp-route-id="@c.print_request_id">@c.request_number</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
