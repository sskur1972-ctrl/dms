@using DMS.Model.Account
@model UserPassword
@{
    string defaultUrl = ViewBag.Link;
    string DetectUrl = ViewBag.LinkDetect;
}

<style>

    .color-picker-label {
        font-weight: 500;
        color: #333;
    }

    .color-picker {
        width: 40px;
        height: 30px;
        border: none;
        cursor: pointer;
        border-radius: 8px;
        padding: 5px;
    }
</style>

<!-- end page title -->
<form id="frmSubmit" onsubmit=" return submitForm()" asp-controller="Account" asp-action="ChangePassword" enctype="multipart/form-data" class="row g-3 needs-validation" novalidate>
    <div class="container-fluid">

        <div class="row">
            <div class="col-xl-3">
            </div>
            <div class="col-xl-6">

                <div class="row">
                    <div class="card h-auto ">

                        <div class="card-header">

                            <h4 class="card-title">Change Password</h4>


                        </div>
                        <div class="card-body">


                            <div class="form-row row">

                                 <div class="form-group col-xl-12  mb-4">
                                    <label class="form-label">Email </label>
                                    <input readonly class="form-control bg-light" asp-for="emailid" />

                                </div>

                                <div class="form-group col-xl-12  mb-4">
                                    <label class="form-label">Old Password</label><span class="text-danger ms-1">*</span>
                                    <input hidden asp-for="ID" />
                                   
                                    <input type="password" class="form-control" id="old_pass" asp-for="oldpassword" onchange="oldpasswordconfrimation()"
                                           placeholder="Enter Old Password" maxlength="12" required>
                                    <span id="old_pass_error" class="text-danger"></span>
                                </div>

                                <div class="form-group col-xl-12  mb-4">
                                    <label class="form-label">New Password</label><span class="text-danger ms-1">*</span>
                                    <input type="password" class="form-control" id="new_pass" asp-for="newpassword"
                                           placeholder="Enter New Password" maxlength="16" required>
                                    <span id="new_pass_error" class="text-danger"></span>
                                    <span id="password_error1"></span>
                                </div>

                            </div>
                            <div class="d-flex justify-content-between align-items-center flex-wrap">
                                <div class="d-flex align-items-center gap-3 mb-4">
                                </div>
                                <div class="d-flex gap-3 align-items-center flex-wrap mb-4">

                                    <button type="submit" class="btn btn-success" id="save_btn">
                                        Update
                                    </button>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-3">
            </div>
        </div>



    </div>
</form>


@{
    string passwordRegex = "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[@$!%*?&])[A-Za-z\\d@$!%*?&]+$";
}
<script>


        document.getElementById("new_pass").addEventListener("input", function () {

             debugger
            const password = this.value;
            const hint = document.getElementById("password_error1");

            // Use Razor to correctly pass the regex to JavaScript
            const regex = new RegExp(@Html.Raw(Json.Serialize(passwordRegex)));

            if (!regex.test(password)) {
                hint.style.color = "red";
                hint.textContent = "Weak password ! Password must contains uppercase, lowercase, number, and special character.";
            } else {
                hint.style.color = "green";
                hint.textContent = "Strong password !";
            }
        });

    function oldpasswordconfrimation() {

        debugger
        var Id = $("#ID").val();
        var oldpassword = $("#old_pass").val();

        $.ajax({
            type: "post",
            url: "@Url.Action("ConfrimOldpassword", "Account")",
            dataType: "json",
            data: { "Id": Id, "oldpassword": oldpassword },
            success: function (msg) {
                if (msg.value == "empty") {
                    Swal.fire({
                        type: 'error',
                        title: 'Old Password...',
                        text: "Please enter correct old password"
                    })
                    $("#old_pass").val('');

                }
            },

        });
    }


      function submitForm() {

       debugger
       var fields = [
           { id: "#old_pass", errorId: "#old_pass_error", message: "Please Enter Old Password" },
           { id: "#new_pass", errorId: "#new_pass_error", message: "Please Enter New Password" }
       ];

       var allFilled = true;

       fields.forEach(function (field) {
           var value = $(field.id).val();
           if (value == null || value == 0) {
               allFilled = false;
               $(field.errorId).text(field.message);

           } else {
               $(field.errorId).text("");
           }

           $(field.id).on("input change", function () {
               if ($(this).val() != null && $(this).val() != 0) {
                   $(field.errorId).text("");
               }
           });
       });

        debugger
               const hint = document.getElementById("password_error1").innerText;

                if (hint != "Strong password !") {
                    return false;
                }

       if (allFilled) {

           document.getElementById("frmSubmit").submit();
       }
       return false;
    }

</script>