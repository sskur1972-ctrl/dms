@using DMS.Web.Services.Export
@model List<ReportDefinition>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["PageTitle"] = "Reports";
    ViewData["Section"] = "Compliance";
}
<partial name="_AdminPageTitle" />

<div class="row g-3">
    @foreach (var r in Model)
    {
        <div class="col-xl-4 col-md-6">
            <a asp-action="Run" asp-route-id="@r.Code" class="text-reset">
                <div class="card h-100 mb-0"><div class="card-body">
                    <h6 class="mb-1">@r.Title</h6>
                    <p class="small text-muted mb-2">@r.Description</p>
                </div></div>
            </a>
        </div>
    }
</div>
<p class="small text-muted mt-3">Reports read the live data. An export (CSV / Excel) is recorded in the audit trail with its parameters and the SHA-256 of the file.</p>
