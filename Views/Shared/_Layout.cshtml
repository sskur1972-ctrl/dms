        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll('.selectchoice').forEach(function (el) {
                const choice = new Choices(el, {
                    searchEnabled: true,
                    searchPlaceholderValue: 'Search...',
                    itemSelectText: '',
                    removeItemButton: true,
                    shouldSort: false
                });

                // Check space dynamically
                el.addEventListener('showDropdown', function () {
                    const rect = el.getBoundingClientRect();
                    const dropdown = el.closest('.choices').querySelector('.choices__list--dropdown');

                    if (window.innerHeight - rect.bottom < 200) {
                        // Not enough space below → open upward
                        dropdown.style.bottom = '100%';
                        dropdown.style.top = 'auto';
                    } else {
                        // Enough space → open downward
                        dropdown.style.top = '100%';
                        dropdown.style.bottom = 'auto';
                    }
                });
            });
        });

