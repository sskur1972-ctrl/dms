        //             $badge.text(response.count > 99 ? "99+" : response.count).show();
        //         } else {
        //             $badge.hide();
        //         }
        //     });
        // }

        $(document).ready(function () {

           // refreshNotificationBadge();
           

            $('.NumbersOnly').keyup(function () {
                // Remove any characters that are not digits or a decimal point
                this.value = this.value.replace(/[^0-9.]/g, '');

                // Remove leading decimal point
                if (this.value.startsWith('.')) {
                    this.value = this.value.substring(1);
                }

                // Ensure that there's only one decimal point in the value
                if ((this.value.match(/\./g) || []).length > 1) {
                    this.value = this.value.replace(/\.+$/, "");
                }
            });


            $(".alphaspace").on("keyup", function () {

                var regex = /[^a-zA-Z ]/g;

                if (this.value.match(regex)) {

                    this.value = this.value.replace(regex, '');

                }

            });



            // Alphanumeric with space allowed
            $(".alphanumeric").on("keyup", function () {
                var regex = /[^a-zA-Z0-9 ]/g;

                if (this.value.match(regex)) {
                    this.value = this.value.replace(regex, '');
                }
            });



        });

        

    </script>


