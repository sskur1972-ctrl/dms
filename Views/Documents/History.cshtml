@using DMS.Model.Documents
@model DocumentHistoryViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var d = Model.Document;
    ViewData["PageTitle"] = "Revisions · " + d.document_number;
    ViewData["Section"] = "Documents";
    string Badge(string? css) => string.IsNullOrEmpty(css) ? "bg-secondary" : css;
}
<partial name="_AdminPageTitle" />

<div class="d-flex align-items-center mb-3 gap-2">
    <div class="flex-grow-1"><span class="fw-semibold">@d.document_number</span> · @d.title · <span class="badge @Badge(d.badge_css_class)">@d.state_name</span></div>
    @if (Model.Versions.Count > 1 && Model.Access.can_view_content)
    {
        <a class="btn btn-soft-primary" asp-action="Compare" asp-route-id="@d.id"><i class="ri-git-compare-line me-1"></i> Compare the last two revisions</a>
    }
    <a class="btn btn-light" asp-action="Details" asp-route-id="@d.id">Back to document</a>
</div>

<div class="card">
    <div class="card-header"><h5 class="card-title mb-0">Revisions <small class="text-muted fw-normal">- every revision is a new record; nothing is overwritten</small></h5></div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle mb-0">
                <thead class="table-light"><tr><th>Revision</th><th>State</th><th>Supersedes</th><th>Change control</th><th>Description of change</th><th>Effective</th><th>Superseded / obsolete</th><th>Authorized</th><th>Signatures</th><th>File</th><th></th></tr></thead>
                <tbody>
                    @foreach (var v in Model.Versions)
                    {
                        <tr class="@(v.id == d.effective_version_id ? "table-success" : "")">
                            <td class="fw-semibold">@v.version_no
                                @if (!v.is_temp_revision_final && !string.IsNullOrEmpty(v.temp_revision_no)) { <div class="small text-muted">@v.temp_revision_no</div> }
                                @if (v.id == d.effective_version_id) { <div><span class="badge bg-success">in force</span></div> }
                            </td>
                            <td><span class="badge @Badge(v.badge_css_class)">@v.state_name</span></td>
                            <td>@(v.supersedes_version_no ?? "-")</td>
                            <td>@(v.change_control_number ?? "-")</td>
                            <td>@v.change_summary</td>
                            <td>@v.effective_from?.ToString("dd-MMM-yyyy")</td>
                            <td>@v.obsolete_on?.ToString("dd-MMM-yyyy")</td>
                            <td>@(v.authorized_at == null ? "-" : $"{v.authorized_at:dd-MMM-yyyy} {v.authorized_by_name}")</td>
                            <td>@v.signature_count</td>
                            <td class="small">@v.source_file_name<div class="font-monospace text-muted" title="@v.source_sha256">@(v.source_sha256?.Length > 12 ? v.source_sha256[..12] + "…" : "")</div></td>
                            <td class="text-nowrap">
                                @if (Model.Access.can_view_content && v.source_storage_path != null) { <a class="btn btn-sm btn-light" asp-action="Read" asp-route-id="@d.id" asp-route-versionId="@v.id">Read</a> }
                                @{ var prev = Model.Versions.Where(x => x.version_seq < v.version_seq).OrderByDescending(x => x.version_seq).FirstOrDefault(); }
                                @if (prev != null && Model.Access.can_view_content) { <a class="btn btn-sm btn-soft-primary" asp-action="Compare" asp-route-id="@d.id" asp-route-left="@prev.id" asp-route-right="@v.id">vs @prev.version_no</a> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-7">
        <div class="card">
            <div class="card-header"><h5 class="card-title mb-0">Electronic signatures</h5></div>
            <div class="card-body">
                @if (Model.Signatures.Count == 0) { <p class="text-muted mb-0">None yet.</p> }
                else
                {
                    <table class="table table-sm table-bordered mb-0">
                        <thead class="table-light"><tr><th>Rev</th><th>Meaning</th><th>Signed by</th><th>When</th></tr></thead>
                        <tbody>
                            @foreach (var g in Model.Signatures.OrderByDescending(x => x.signed_at_utc))
                            {
                                <tr title="@g.manifestation_text"><td>@g.version_label</td><td>@g.signature_meaning</td><td>@g.signer_printed_name <small class="text-muted">(@g.user_name)</small></td><td class="text-nowrap">@g.signed_at_local_display</td></tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
    <div class="col-xl-5">
        <div class="card">
            <div class="card-header"><h5 class="card-title mb-0">Temporary revision numbers</h5></div>
            <div class="card-body">
                @if (Model.TempRevisions.Count == 0) { <p class="text-muted mb-0">None issued.</p> }
                else
                {
                    <table class="table table-sm table-bordered mb-0">
                        <thead class="table-light"><tr><th>Temporary</th><th>Issued at</th><th>By</th><th>Final</th></tr></thead>
                        <tbody>
                            @foreach (var t in Model.TempRevisions)
                            {
                                <tr><td>@t.temp_revision_no</td><td>@(t.issued_at_stage_code ?? t.issued_at_state_code)<div class="small text-muted">@t.issued_at.ToString("dd-MMM-yyyy HH:mm")</div></td><td>@t.issued_by_name</td><td>@(t.finalized_version_no ?? "-")</td></tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><h5 class="card-title mb-0">Lifecycle history</h5></div>
    <div class="card-body">
        <table class="table table-sm table-bordered mb-0">
            <thead class="table-light"><tr><th>When</th><th>Rev</th><th>Action</th><th>From → To</th><th>By</th><th>Signature</th><th>Comment / reason</th></tr></thead>
            <tbody>
                @foreach (var h in Model.History)
                {
                    <tr><td class="text-nowrap">@h.performed_at.ToString("dd-MMM-yyyy HH:mm")</td><td>@h.version_no</td><td>@h.action_code</td><td>@h.from_state → @h.to_state</td><td>@h.performed_by_name</td><td>@h.signature_meaning</td><td>@h.comments@if (!string.IsNullOrEmpty(h.reason)) { <div class="small text-muted">Reason: @h.reason</div> }</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
