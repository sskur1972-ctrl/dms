@using DMS.Model.Account;
@model ForgetPassVM
@{
    Layout = null;
    ViewBag.Title = "Login";
}

<!DOCTYPE html>
<html lang="en" class="h-100">

<head>
    <title>Empowering compliance through digital innovation.</title>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="author" content="Propix Technology Pvt Ltd">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="16x16" href="~/assets_v1/images/favicon.ico">

    <!-- CSS -->
    <link href="~/assets_v1/css/style.css" rel="stylesheet">
    <link href="~/assets_v1/vendor/sweetalert2/dist/sweetalert2.min.css" rel="stylesheet">
    <link href="~/assets_v1/vendor/owl-carousel/owl.carousel.css" rel="stylesheet">
</head>

<body class="h-100">
    <div class="login-account">
        <div class="row h-100">
            <div class="col-lg-6 align-self-start">
                <div class="account-info-area" style="background-image: url('@Url.Content("~/assets_v1/images/rainbow.gif")');">
                    <div class="login-content">
                        <p class="sub-title">Log in to your admin dashboard with your credentials</p>
                        <h1 class="title">The Evolution of <span>EAMS</span></h1>
                        <p class="text">Know What You Own. Control What You Use.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-md-7 col-sm-12 mx-auto align-self-center">
                <div class="login-form">
                    <div class="login-head">
                        <p>Smarter Control of Your Business Assets.</p>
                    </div>
                    <h6 class="login-title"><span>Forgot Password</span></h6>

                    <!-- Success/Error messages -->
                    @if (TempData["success"] != null)
                    {
                        <div class="alert alert-success text-center">@TempData["success"]</div>
                    }
                    @if (TempData["error"] != null)
                    {
                        <div class="alert alert-danger text-center">@TempData["error"]</div>
                    }

                    <form method="post" asp-controller="Account" asp-action="ForgotPassword" class="row g-3 needs-validation">
                        <div class="mb-1">
                            <label asp-for="EmailId" class="form-label">Email Address</label>
                            <input asp-for="EmailId" class="form-control" type="email" placeholder="Enter Email" required />
                            <span asp-validation-for="EmailId" class="text-danger"></span>
                        </div>

                        <div class="text-center mb-1">
                            <button type="submit" class="btn btn-primary btn-block">Submit</button>
                        </div>
                        <div class="text-center mb-1">
                            <a class="btn btn-warning btn-block" asp-controller="Account" asp-action="Login">Home</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <partial name="_Notification" />

    <!-- Scripts -->
    <script src="~/assets_v1/js/jquery-3.6.0.min.js"></script>
    <script src="~/assets_v1/vendor/global/global.min.js"></script>
    <script src="~/assets_v1/vendor/sweetalert2/dist/sweetalert2.min.js"></script>
    <script src="~/assets_v1/js/custom.min.js"></script>
    <script src="~/assets_v1/js/deznav-init.js"></script>

    <style>
        .login-account .account-info-area:after {
            background-color: #4a7a7c !important;
        }

        .btn-primary {
            border-color: #4a7a7c !important;
            background-color: #4a7a7c !important;
        }
    </style>
</body>
</html>
