@using DMS.Model.Master
@using DMS.Model.Account
@model List<AccessRule>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["PageTitle"] = "Document Access Matrix";
    var types = ViewBag.types as List<DocumentType> ?? new List<DocumentType>();
    var roles = ViewBag.roles as List<RoleDropDownViewModel> ?? new List<RoleDropDownViewModel>();
    long? typeId = ViewBag.documentTypeId as long?;
    int? roleId = ViewBag.roleId as int?;
    Func<bool, Microsoft.AspNetCore.Html.IHtmlContent> tick = b => new Microsoft.AspNetCore.Html.HtmlString(
        b ? "<i class=\"ri-checkbox-circle-fill text-success\"></i>" : "<i class=\"ri-close-line text-muted\"></i>");
}
<partial name="_DataTableCSS" />
<partial name="_AdminPageTitle" />

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header border-0">
                <form method="get" asp-action="Index" class="row g-3 align-items-end">
                    <div class="col-sm-3">
                        <label class="form-label mb-1">Document Type</label>
                        <select name="documentTypeId" class="form-select" onchange="this.form.submit()">
                            <option value="">All types (default rules)</option>
                            @foreach (var t in types)
                            {
                                <option value="@t.id" selected="@(typeId == t.id)">@t.code - @t.name</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <label class="form-label mb-1">Role</label>
                        <select name="roleId" class="form-select" onchange="this.form.submit()">
                            <option value="">All roles</option>
                            @foreach (var r in roles)
                            {
                                <option value="@r.RoleId" selected="@(roleId == r.RoleId)">@r.role_name</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm text-muted small">Rules are combined: a right granted by the type-specific rule or by the "all types" rule of any of the user's roles is granted. What no rule grants is denied.</div>
                    <div class="col-sm-auto ms-auto">
                        <a class="btn btn-danger add-btn" asp-action="Edit" asp-route-roleId="@(roleId ?? 0)" asp-route-documentTypeId="@typeId"><i class="ri-add-line align-bottom me-1"></i> Add / Change Rule</a>
                    </div>
                </form>
            </div>
            <div class="card-body">
                <table id="assetlist" class="table nowrap dt-responsive align-middle table-hover table-bordered" style="width:100%">
                    <thead class="table-light">
                        <tr>
                            <th>Role</th>
                            <th>State</th>
                            <th>Type</th>
                            <th>View</th>
                            <th>Content</th>
                            <th>Comment</th>
                            <th>Create</th>
                            <th>Edit</th>
                            <th>Author</th>
                            <th>Upload</th>
                            <th>Print</th>
                            <th>Export</th>
                            <th>Screen capture</th>
                            <th>Watermark</th>
                            <th width="5%" class="not-export-col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td><strong>@a.role_name</strong></td>
                                <td>@a.state_name</td>
                                <td>@(a.document_type_code ?? "All")</td>
                                <td>@tick(a.can_view)</td>
                                <td>@tick(a.can_view_content)</td>
                                <td>@tick(a.can_comment)</td>
                                <td>@tick(a.can_create)</td>
                                <td>@tick(a.can_edit)</td>
                                <td>@tick(a.can_author)</td>
                                <td>@tick(a.can_upload)</td>
                                <td>@tick(a.can_print)</td>
                                <td>@tick(a.can_export)</td>
                                <td>@tick(a.allow_screen_capture)</td>
                                <td>@tick(a.apply_screen_watermark)</td>
                                <td><center><a class="btn btn-soft-secondary btn-sm" asp-action="Edit" asp-route-roleId="@a.role_id" asp-route-stateId="@a.state_id" asp-route-documentTypeId="@a.document_type_id" title="Edit"><i class="ri-pencil-fill"></i></a></center></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<partial name="_AdminTableJS" />
<script>
    document.addEventListener('DOMContentLoaded', function () { initAdminTable('#assetlist', [0, 1, 2], [[0, 'asc']]); });
</script>
