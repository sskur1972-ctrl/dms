    <script>

        function checkFileSize(input, documentid, docerror) {

            debugger;

            var validExtensions = ["jpg", "jpeg", "pdf", "doc", "xls", "xlsx", "docx"];
            var fileInput = document.getElementById(documentid);
            var fileName = input.value;
            var fileExtension = fileName.split('.').pop().toLowerCase();
            if (fileName != "") {
                if (validExtensions.indexOf(fileExtension) === -1) {
                    document.getElementById(docerror).innerText = "Please select a valid file format.Accepted formats include JPG, JPEG, PDF, DOC, XLS, XLSX, and DOCX.";

                    fileInput.value = ""; // Clear file input
                    return false;
                } else {
                    document.getElementById(docerror).innerText = "";
                    var file = input.files[0];
                    var fileSize = file.size;
                    var fileSizeLimit = 2 * 1024 * 1024;
                    if (fileSize > fileSizeLimit) {
                        document.getElementById(docerror).innerText = "Please ensure file size is under 2MB.";
                        fileInput.value = ""; // Clear file input
                        return false;
                    }
                }
                return true;

            }
        }

    </script>


    <script>

        function clearDocument(previewDocID, documentid) {
            $('#' + previewDocID).empty();
            var fileInput = document.getElementById(documentid);
            fileInput.value = ""; // Clear file input
        }

        function previewFile(val, documents, docerror1s, labelname, previewDocID) {

            debugger;

            var showdocument = document.getElementById(documents);

            $('#' + previewDocID).empty();
            showdocument = $('#' + previewDocID);

            var isdocumentok = checkFileSize(val, documents, docerror1s);

            if (isdocumentok) {

                var fileInput = document.getElementById(documents);

                const fileName = fileInput.files[0].name;
                const maxLength = 150; // Example maximum length

                if (fileName.length > maxLength) {

                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: 'File name cannot be longer than ' + maxLength + ' characters , Please rename'

                    })
                    fileInput.value = ""; // Clear file input
                    return false;
                }

                if (fileInput.files.length === 0) {
                    alert('No file selected.');
                    return;
                }

                var formData = new FormData();
                formData.append('file', fileInput.files[0]);

                $.ajax({
                    type: "POST",
                    url: "@Url.Action("viewDocument", "Common")",
                    data: formData,
                    processData: false, // Prevent jQuery from automatically transforming the data into a query string
                    contentType: false, // Prevent jQuery from overriding the Content-Type header
                    success: function (result) {

                        debugger;
                        showdocument.append(`
                                                                                                                                                                                                                        <div class="col-lg-12 col-md-6 col-sm-12">
                                                                                                                                                                                                                            <label style="margin-left: 25px;">${labelname}</label>
                                                                                                                                                                                                                            <div class="card-body" data-simplebar>
                                                                                                                                                                                                                                <div class="row d-flex align-items-center border border-primary p-2 rounded">
                                                                                                                                                                                                                                    <div class="col-2 flex-shrink-0 avatar-sm">
                                                                                                                                                                                                                                        <div class="avatar-title bg-light rounded">
                                                                                                                                                                                                                                            ${result.fileType === "pdf" ?
                                '<i class="ri-file-pdf-fill fs-20 text-danger"></i>' :
                                result.fileType === "doc" || result.fileType === "docx" ?
                                    '<i class="ri-file-word-fill fs-20 text-primary"></i>' :
                                    result.fileType === "xls" || result.fileType === "xlsx" ?
                                        '<i class="ri-file-excel-fill fs-20 text-success"></i>' :
                                        '<i class="ri-image-2-fill fs-20 text-info"></i>'}
                                                                                                                                                                                                                                        </div>
                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                    <div class="col-5 flex-grow-1 ms-3">
                                                                                                                                                                                                                                        <h6 class="mb-1" style="font-size: 10px">
                                                                                                                                                                                                                                                    <a href="/UploadFiles/CommontmpDocument/${result.systemFileName}" target="_blank">${result.userFileName}</a>
                                                                                                                                                                                                                                        </h6>
                                                                                                                                                                                                                                    </div>
                                                                                                                                                                                                                                            <div class="col-5 d-flex justify-content-end hstack gap-3 fs-16">
                                                                                                                                                                                                                                                <a href="/UploadFiles/CommontmpDocument/${result.systemFileName}" title="view" class="text-muted" target="_blank">
                                                                                                                                                                                                                                            <i class="ri-eye-fill align-bottom text-muted"></i>
                                                                                                                                                                                                                                        </a>
                                                                                                                                                                                                                                                                                        <a class="text-danger d-inline-block remove-item-btn" onclick="clearDocument('${previewDocID}' ,'${documents}');">
                                                                                                                                                                                                                                                                <i class="ri-delete-bin-5-fill fs-16"></i>
                                                                                                                                                                                                                                                            </a>
                                                                                                                                                                                                                                    </div>

                                                                                                                                                                                                                                </div>
                                                                                                                                                                                                                            </div>
                                                                                                                                                                                                                        </div>
                                                                                                                                                                                                                                    `);
                    },
                    error: function (xhr, status, error) {
                        alert('Error - ' + error);
                    }
                });
            }
        }

