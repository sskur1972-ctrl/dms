@using DMS.Model.Master
@model DocumentType
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["PageTitle"] = Model.id > 0 ? "Edit Document Type" : "Add Document Type";
}
<partial name="_AdminPageTitle" />

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-header"><h4 class="card-title mb-0">@ViewData["PageTitle"] @(Model.id > 0 ? "- " + Model.code : "")</h4></div>
            <div class="alert alert-warning py-2 m-3 mb-0" role="alert" style="font-size: 14px;">
                ⚠ Fields marked <span style="color: red;">*</span> are required. This is a GxP configuration change: the reason is recorded in the audit trail.
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post" class="row g-3" onsubmit="return checkReason()">
                    <input type="hidden" asp-for="id" />
                    <div class="form-group col-xl-3 mb-3">
                        <label asp-for="code" class="form-label"></label> <span style="color: red;">*</span>
                        <input asp-for="code" class="form-control text-uppercase" maxlength="32" required readonly="@(Model.id > 0)" autocomplete="off" />
                        @if (Model.id > 0) { <small class="text-muted">The code is part of issued document numbers and cannot be changed.</small> }
                    </div>
                    <div class="form-group col-xl-6 mb-3">
                        <label asp-for="name" class="form-label"></label> <span style="color: red;">*</span>
                        <input asp-for="name" class="form-control" maxlength="160" required autocomplete="off" />
                    </div>
                    <div class="form-group col-xl-3 mb-3">
                        <label asp-for="category" class="form-label"></label>
                        <input asp-for="category" class="form-control" maxlength="64" autocomplete="off" />
                    </div>
                    <div class="form-group col-xl-12 mb-3">
                        <label asp-for="description" class="form-label"></label>
                        <textarea asp-for="description" class="form-control" rows="2" maxlength="1000"></textarea>
                    </div>
                    <div class="form-group col-xl-3 mb-3">
                        <label asp-for="routing_mode" class="form-label"></label>
                        <select asp-for="routing_mode" class="form-select">
                            <option value="SEQUENTIAL">Sequential</option>
                            <option value="PARALLEL">Parallel</option>
                        </select>
                    </div>
                    <div class="form-group col-xl-3 mb-3">
                        <label asp-for="default_sla_days" class="form-label"></label>
                        <input asp-for="default_sla_days" type="number" min="1" max="365" class="form-control" />
                    </div>
                    <div class="form-group col-xl-3 mb-3">
                        <label asp-for="periodic_review_months" class="form-label"></label>
                        <input asp-for="periodic_review_months" type="number" min="0" max="240" class="form-control" />
                    </div>
                    <div class="form-group col-xl-3 mb-3">
                        <label asp-for="retention_years" class="form-label"></label>
                        <input asp-for="retention_years" type="number" min="0" max="100" class="form-control" />
                    </div>
                    <div class="form-group col-xl-3 mb-3">
                        <label asp-for="display_order" class="form-label"></label>
                        <input asp-for="display_order" type="number" class="form-control" />
                    </div>
                    <div class="form-group col-xl-6 mb-3">
                        <label asp-for="master_format_number_label" class="form-label"></label>
                        <input asp-for="master_format_number_label" class="form-control" maxlength="64" placeholder="e.g. Format No." />
                    </div>
                    <div class="col-xl-12 mb-2">
                        <div class="form-check form-check-inline"><input class="form-check-input" asp-for="requires_change_control" /><label class="form-check-label" asp-for="requires_change_control"></label></div>
                        <div class="form-check form-check-inline"><input class="form-check-input" asp-for="requires_training" /><label class="form-check-label" asp-for="requires_training"></label></div>
                        <div class="form-check form-check-inline"><input class="form-check-input" asp-for="requires_master_format_number" /><label class="form-check-label" asp-for="requires_master_format_number"></label></div>
                        <div class="form-check form-check-inline"><input class="form-check-input" asp-for="is_active" /><label class="form-check-label" asp-for="is_active"></label></div>
                    </div>
                    <div class="form-group col-xl-12 mb-3">
                        <label class="form-label" for="reason">Reason for change</label> <span style="color: red;">*</span>
                        <textarea id="reason" name="reason" class="form-control" rows="2" maxlength="1000" required></textarea>
                        <span id="reason_error" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <div class="text-end">
                            <a asp-action="Index" class="btn btn-primary ms-2">Back To List</a>
                            <button type="submit" class="btn btn-success">Save</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    function checkReason() {
        var ok = document.getElementById('reason').value.trim().length >= 3;
        document.getElementById('reason_error').textContent = ok ? '' : 'Please enter the reason for this change.';
        return ok;
    }
</script>
