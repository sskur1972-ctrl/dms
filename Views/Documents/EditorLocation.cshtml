@{ Layout = null; }
<!doctype html><html><head><meta charset="utf-8"><title>Saved document location</title><style>body{font:16px sans-serif;padding:24px}mark{background:#ffea79}.watermark{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;opacity:.14;pointer-events:none;font-size:clamp(54px,8vw,110px);font-weight:bold}.watermark span{transform:rotate(-35deg)}@@media print{body{display:none}}</style></head><body>@if(ViewData["LocatorWatermark"] != null){<div class="watermark"><span>@ViewData["LocatorWatermark"]</span></div>}<main id="saved-content">@Html.Raw(ViewData["SavedHtml"])</main></body></html>
