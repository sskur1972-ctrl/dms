@using DMS.Model.Master
@model List<Printer>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["PageTitle"] = "Registered Printers";
}
<partial name="_DataTableCSS" />
<partial name="_AdminPageTitle" />

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header border-0">
                <div class="row g-4 align-items-center">
                    <div class="col-sm"><p class="text-muted mb-0">Controlled copies can only be issued to a registered printer. A printer is never deleted - the print log keeps referring to it.</p></div>
                    <div class="col-sm-auto ms-auto">
                        <a class="btn btn-danger add-btn" asp-action="Edit" asp-route-id="0"><i class="ri-add-line align-bottom me-1"></i> Add Printer</a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <table id="assetlist" class="table nowrap dt-responsive align-middle table-hover table-bordered" style="width:100%">
                    <thead class="table-light">
                        <tr>
                            <th>Order</th>
                            <th>Printer Name</th>
                            <th>IP Address</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th width="5%" class="not-export-col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.display_order</td>
                                <td><strong>@item.printer_name</strong></td>
                                <td>@item.ip_address</td>
                                <td>@item.location</td>
                                <td>
                                    @if (item.is_active) { <span class="badge bg-success-subtle text-success">Active</span> }
                                    else { <span class="badge bg-danger-subtle text-danger">Inactive</span> }
                                </td>
                                <td>
                                    <center>
                                        <div class="dropdown d-inline-block">
                                            <button class="btn btn-soft-secondary btn-sm dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="ri-more-fill align-middle"></i></button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.id"><i class="ri-pencil-fill align-bottom me-2 text-muted"></i> Edit</a></li>
                                                <li>
                                                    <button type="button" class="dropdown-item" onclick="openReasonModal(this)"
                                                            data-url="@Url.Action("SetActive")" data-input="none"
                                                            data-fields='@Json.Serialize(new { id = item.id, isActive = !item.is_active })'
                                                            data-title="@(item.is_active ? "Deactivate" : "Reactivate")"
                                                            data-text="@(item.is_active ? "It will no longer be offered for controlled prints." : "Make this entry available again?")">
                                                        <i class="@(item.is_active ? "ri-close-circle-line" : "ri-checkbox-circle-line") align-bottom me-2 text-muted"></i> @(item.is_active ? "Deactivate" : "Reactivate")
                                                    </button>
                                                </li>
                                            </ul>
                                        </div>
                                    </center>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<partial name="_ReasonModal" />
<partial name="_AdminTableJS" />
<script>
    document.addEventListener('DOMContentLoaded', function () { initAdminTable('#assetlist', [0, 1, 2, 3, 4], [[0, 'asc']]); });
</script>
