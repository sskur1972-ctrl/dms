@using DMS.Model.Account
@model List<UserforIndexmodel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    string username = "";
    string userId = "";
    string displayname = "";
    string _permissionList = String.Empty;

}
@{
    try
    {
        @if (User.Identity.IsAuthenticated)
        {
            var claimsCount = User.Claims.Count();

            if (claimsCount > 0)
            {
                // Retrieve the custom claim value from the user's claims
                username = User.Identity.Name;
                displayname = User.Claims.FirstOrDefault(c => c.Type == "empname")?.Value;
                userId = User.Claims.FirstOrDefault(c => c.Type == "UserID")?.Value;
                _permissionList = User.Claims.FirstOrDefault(c => c.Type == "serializedPermissionList")?.Value;
            }
        }

    }
    catch (Exception ex)
    {
        displayname = ex.ToString();
    }
}

<partial name="_DataTableCSS" />
<div class="row">

    <div class="col-12">

        <div class="page-title-box d-sm-flex align-items-center justify-content-between">

            <h4 class="mb-sm-0">User Management</h4>



            <div class="page-title-right">

                <ol class="breadcrumb m-0">

                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboards</a></li>

                    <li class="breadcrumb-item active">User List
                        <li>

                </ol>

            </div>




        </div>

    </div>

</div>

<div class="row">

    <div class="col-lg-12">

        <div class="card" id="leadsList">
            <div class="card-header border-0">

                <div class="row g-4 align-items-center">

                    <div class="col-sm-auto ms-auto">

                        <div class="hstack gap-2">
                            @if (_permissionList.Contains("\"Create User\""))
                            {

                                <a class="btn btn-danger add-btn" asp-controller="User" asp-action="Create"><i class="ri-add-line align-bottom me-1"></i> Add User</a>

                            }
                        </div>

                    </div>

                </div>

            </div>
            <div class="card-body">
                <div class="row">
                    <div class="card-body">
                        <table id="assetlist" class="table nowrap dt-responsive align-middle table-hover table-bordered" style="width:100%">
                            <thead class="table-light">
                                <tr class="table-light">
                                    <th>Display Name</th>
                                    <th>Email</th>
                                    <th>Role Name</th>
                                    <th width="5%" class="not-export-col">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tblAsset">
                                @foreach (var models in Model.OrderBy(m => m.pk_user))
                                {
                                    @if (models != null)
                                    {
                                        <tr>
                                            <td>@models.DisplayName</td>
                                            <td>@models.emailid</td>
                                            <td>@models.RoleName</td>
                                            <td>
                                                <center>
                                                    <div class="dropdown d-inline-block">
                                                        <button class="btn btn-soft-secondary btn-sm dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                            <i class="ri-more-fill align-middle"></i>
                                                        </button>
                                                        <ul class="dropdown-menu">
                                                            @if (_permissionList != null)
                                                            {
                                                                @if (_permissionList.Contains("\"View User\""))
                                                                {
                                                                    <li>
                                                                        <a class="dropdown-item" asp-controller="User" asp-action="Details" asp-route-id="@models.pk_user">
                                                                            <i class="ri-eye-fill align-bottom me-2 text-muted"></i>View
                                                                        </a>
                                                                    </li>
                                                                }
                                                                @if (_permissionList.Contains("\"Edit User\""))
                                                                {
                                                                    <li>
                                                                        <a class="dropdown-item" asp-controller="User" asp-action="Edit" asp-route-id="@models.pk_user">

                                                                            <i class="ri-pencil-fill align-bottom me-2 text-muted"></i>Edit
                                                                        </a>
                                                                    </li>
                                                                }
                                                                @if (_permissionList.Contains("\"Delete User\""))
                                                                {
                                                                    <li>
                                                                        <a class="dropdown-item" asp-controller="User" asp-action="Delete" asp-route-id="@models.pk_user">

                                                                            <i class="ri-delete-bin-fill align-bottom me-2 text-muted"></i>Delete
                                                                        </a>
                                                                    </li>
                                                                }


                                                               

                                                            }
                                                        </ul>

                                                    </div>

                                                </center>
                                            </td>

                                        </tr>
                                    }
                                }

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="_DataTableJS" />

<script>
    document.addEventListener('DOMContentLoaded', function () {
        let table = new DataTable('#assetlist', {
            "pagingType": "full_numbers",
            displayLength: 10,
            dom: 'Bfrtip',
            buttons: [
                {
                    extend: 'print',
                    exportOptions: {
                        columns: [0,1,2,3]
                    }
                },
                {
                   extend: 'excel',
                    exportOptions: {
                        columns: [0, 1, 2, 3]
                    }
                },
            ],
            // columnDefs: [
            //     {
            //         targets: [6],
            //         orderable: false
            //     }
            // ],
            order: [[1, 'desc']]
        });
    });
</script>
