@using DMS.Model.Master
@model Department
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["PageTitle"] = Model.id > 0 ? "Edit Department" : "Add Department";
    var parents = ViewBag.parents as List<Department> ?? new List<Department>();
}
<partial name="_AdminPageTitle" />

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-header"><h4 class="card-title mb-0">@ViewData["PageTitle"]</h4></div>
            <div class="alert alert-warning py-2 m-3 mb-0" role="alert" style="font-size: 14px;">
                ⚠ Fields marked <span style="color: red;">*</span> are required. The code is used in document numbers and cannot be re-used by another department.
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post" class="row g-3">
                    <input type="hidden" asp-for="id" />
                    <input type="hidden" asp-for="is_active" />
                    <div class="form-group col-xl-6 mb-4">
                        <label asp-for="code" class="form-label"></label> <span style="color: red;">*</span>
                        <input asp-for="code" class="form-control text-uppercase" maxlength="16" required placeholder="e.g. QA" autocomplete="off" />
                        <span asp-validation-for="code" class="text-danger"></span>
                    </div>
                    <div class="form-group col-xl-6 mb-4">
                        <label asp-for="name" class="form-label"></label> <span style="color: red;">*</span>
                        <input asp-for="name" class="form-control" maxlength="128" required placeholder="e.g. Quality Assurance" autocomplete="off" />
                        <span asp-validation-for="name" class="text-danger"></span>
                    </div>
                    <div class="form-group col-xl-6 mb-4">
                        <label asp-for="parent_id" class="form-label"></label>
                        <select asp-for="parent_id" class="form-select">
                            <option value="">-- None --</option>
                            @foreach (var p in parents)
                            {
                                <option value="@p.id" selected="@(Model.parent_id == p.id)">@p.code - @p.name</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <div class="text-end">
                            <a asp-action="Index" class="btn btn-primary ms-2">Back To List</a>
                            <button type="submit" class="btn btn-success">Save</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
