@using DMS.Model.Documents
@model List<LegacyRowResult>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var b = (LegacyBatchRow)ViewBag.batch;
    ViewData["PageTitle"] = "Legacy Import " + b.batch_reference;
    ViewData["Section"] = "Compliance";
}
<partial name="_AdminPageTitle" />

<div class="card">
    <div class="card-header d-flex align-items-center">
        <h5 class="card-title mb-0 flex-grow-1">@b.batch_reference @(b.dry_run ? "(validation only)" : "") · <span class="badge bg-secondary">@b.status</span></h5>
        <a class="btn btn-sm btn-light" asp-action="Index">Back</a>
    </div>
    <div class="card-body">
        <dl class="row small">
            <dt class="col-sm-3">Rows</dt><dd class="col-sm-9">@b.total_rows · @(b.dry_run ? $"{b.total_rows - b.failed_rows} valid" : $"{b.imported_rows} imported") · @b.failed_rows with problems</dd>
            <dt class="col-sm-3">Package</dt><dd class="col-sm-9">@b.package_name · SHA-256 <span class="font-monospace">@b.package_sha256</span></dd>
            <dt class="col-sm-3">Justification</dt><dd class="col-sm-9">@b.justification</dd>
            @if (!b.dry_run) { <dt class="col-sm-3">Signature meaning</dt><dd class="col-sm-9">@b.signature_meaning (retrospective)</dd> }
            <dt class="col-sm-3">By</dt><dd class="col-sm-9">@b.performed_by_name · @b.started_at.ToString("dd-MMM-yyyy HH:mm:ss") → @b.finished_at?.ToString("HH:mm:ss") UTC</dd>
        </dl>
        @if (b.dry_run && b.failed_rows == 0 && b.total_rows > 0)
        {
            <div class="alert alert-success small">Every row is valid. Run the import with the same package, choosing <em>Import</em> and signing.</div>
        }
        <div class="table-responsive">
            <table class="table table-sm table-bordered small align-middle mb-0">
                <thead class="table-light"><tr><th>Line</th><th>Document number</th><th>Result</th><th>Message</th></tr></thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr class="@(r.succeeded ? "" : "table-danger")">
                            <td>@r.row_no</td>
                            <td>@if (r.document_id != null) { <a asp-controller="Documents" asp-action="Details" asp-route-id="@r.document_id">@r.document_number</a> } else { @r.document_number }</td>
                            <td>@(r.succeeded ? (b.dry_run ? "valid" : "imported") : "not imported")</td>
                            <td>@r.message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
