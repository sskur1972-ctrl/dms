
@model UserNotificationViewModel


@using DMS.Model.Account
@using Newtonsoft.Json;
@{
    List<string> permissions = null;
    string _permissionList = string.Empty;

    string username = "";
    string rolename = "";
    string displayname = "";
    string actionName = string.Empty;
    int PermissionCount = 0;
    List<CurrentUserPermission> deserializedCurrentPermissions = null;

}

@{
    try
    {
        @if (User.Identity.IsAuthenticated)
        {
            var claimsCount = User.Claims.Count();

            if (claimsCount > 0)
            {
                // Retrieve the custom claim value from the user's claims
                username = User.Identity.Name;
                displayname = User.Claims.FirstOrDefault(c => c.Type == "displayName")?.Value;
                rolename = User.Claims.FirstOrDefault(c => c.Type == "Roles_Name")?.Value;
                _permissionList = User.Claims.FirstOrDefault(c => c.Type == "serializedPermissionList")?.Value;
            }
        }

    }
    catch (Exception ex)
    {
        displayname = ex.Message;
    }
}

<div class="row">

    <div class="col-12">

        <div class="page-title-box d-sm-flex align-items-center justify-content-between">

            <h4 class="mb-sm-0">Notification</h4>

            <div class="page-title-right">

                <ol class="breadcrumb m-0">

                    <li class="breadcrumb-item"><a asp-controller="Account" asp-action="NotificationIndex">Notification</a></li>

                    <li class="breadcrumb-item active">View Notification</li>

                </ol>

            </div>

        </div>

    </div>

</div>
             <div class="row">
                 <div class="col-xl-12">
                    <div class="card">
                                <div class="card-header">
                                    <h4 class="card-title">View Notification</h4>
                                </div>
                        <div class="card-body">

                                <form method="post" class="row g-0 needs-validation" enctype="multipart/form-data" novalidate>
                                <div class="row">




                                    <div class="col-6 ">
