@using DMS.Model.Documents
@using DMS.Model.Master
@model List<ImpactPendingItem>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["PageTitle"] = "Impact Review";
    ViewData["Section"] = "Documents";
    var departments = ViewBag.departments as List<Department> ?? new();
    long? dept = ViewBag.departmentId;
}
<partial name="_AdminPageTitle" />

<div class="card">
    <div class="card-header d-flex align-items-center gap-2">
        <h5 class="card-title mb-0 flex-grow-1">Documents to check because a document they reference is being revised</h5>
        <form method="get" asp-action="Impact" class="d-flex gap-2">
            <select name="departmentId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">All departments</option>
                @foreach (var dep in departments.Where(x => x.is_active)) { <option value="@dep.id" selected="@(dep.id == dept)">@dep.code - @dep.name</option> }
            </select>
        </form>
    </div>
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <p class="text-muted mb-0">Nothing is waiting for an impact assessment.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle mb-0">
                    <thead class="table-light"><tr><th>Document to check</th><th>Owner</th><th>References</th><th>Flagged</th><th>Status</th><th style="width: 36%;">Conclusion</th></tr></thead>
                    <tbody>
                        @foreach (var i in Model)
                        {
                            <tr>
                                <td><a asp-action="Details" asp-route-id="@i.source_document_id">@i.source_document_number</a><div class="small text-muted">@i.source_title · @i.source_department_code</div></td>
                                <td>@i.source_owner_name</td>
                                <td><a asp-action="Details" asp-route-id="@i.target_document_id">@i.target_document_number</a><div class="small text-muted">@i.target_state_name@(i.section_reference == null ? "" : " · § " + i.section_reference)</div></td>
                                <td class="text-nowrap">@i.impact_flagged_at?.ToString("dd-MMM-yyyy")</td>
                                <td><span class="badge @(i.impact_flag == "REVIEW_REQUIRED" ? "bg-warning" : "bg-info")">@i.impact_flag?.Replace('_', ' ')</span></td>
                                <td>
                                    <form asp-action="AssessImpact" method="post" class="d-flex gap-1">
                                        <input type="hidden" name="linkId" value="@i.link_id" />
                                        <select name="impactFlag" class="form-select form-select-sm" style="max-width: 190px;" required>
                                            <option value="">Conclusion…</option>
                                            <option value="REVIEW_IN_PROGRESS">Being assessed</option>
                                            <option value="NO_IMPACT_CONFIRMED">No impact (justify)</option>
                                        </select>
                                        <input name="remarks" class="form-control form-control-sm" maxlength="1024" placeholder="Justification / what will change" />
                                        <button class="btn btn-sm btn-soft-primary" type="submit">Record</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <small class="text-muted">When the referencing document itself must change, start its own revision - record "Being assessed" meanwhile.</small>
        }
    </div>
</div>
