@using DMS.Model.Documents
@model List<PrintRequestRow>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["PageTitle"] = "Print Requests";
    ViewData["Section"] = "Controlled Print";
    string status = ViewBag.status as string ?? "OPEN";
    bool mine = ViewBag.mine == true;
    bool canSeeAll = ViewBag.canSeeAll == true;
    var filters = new[] { ("OPEN", "Open"), ("PENDING", "Awaiting QA"), ("AUTHORIZED", "Authorised"), ("ISSUED", "Issued"), ("CLOSED", "Closed"), ("REJECTED", "Rejected"), ("CANCELLED", "Cancelled"), ("", "All") };
}
<partial name="_AdminPageTitle" />

<div class="card">
    <div class="card-header d-flex align-items-center flex-wrap gap-2">
        <h5 class="card-title mb-0 flex-grow-1">Controlled print requests</h5>
        <div class="btn-group btn-group-sm flex-wrap">
            @foreach (var (code, label) in filters)
            {
                <a class="btn @(status == code ? "btn-primary" : "btn-light")" asp-action="Index" asp-route-status="@code" asp-route-mine="@mine">@label</a>
            }
        </div>
        @if (canSeeAll)
        {
            <a class="btn btn-sm @(mine ? "btn-secondary" : "btn-outline-secondary")" asp-action="Index" asp-route-status="@status" asp-route-mine="@(!mine)">@(mine ? "Showing mine" : "Only mine")</a>
        }
    </div>
    <div class="card-body">
        <p class="small text-muted">
            A paper copy of a document in force is raised from the document's page (<em>Request controlled print</em>). QA authorises it with an
            electronic signature; the numbered copies are then printed from the request, and returned or destroyed when the revision is superseded.
        </p>
        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Request</th><th>Document</th><th>Rev</th><th>Type</th><th>Copies</th><th>Out</th><th>Requested by</th><th>Purpose</th><th>Status</th><th>Decided</th><th>Return by</th></tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="11" class="text-center text-muted py-3">No print requests.</td></tr>
                    }
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="text-nowrap"><a asp-action="Details" asp-route-id="@r.id">@r.request_number</a></td>
                            <td><a asp-controller="Documents" asp-action="Details" asp-route-id="@r.document_id">@r.document_number</a><div class="small text-muted">@r.title</div></td>
                            <td>@r.version_no @if (!r.is_version_in_force) { <span class="badge bg-danger-subtle text-danger" title="This revision is no longer in force">not in force</span> }</td>
                            <td class="small">@r.copy_type</td>
                            <td>@r.copies_requested@(r.copies_authorized is int n && n != r.copies_requested ? $" → {n}" : "")</td>
                            <td>@r.copies_out</td>
                            <td class="text-nowrap small">@r.requested_by_name<div class="text-muted">@r.requested_at.ToString("dd-MMM-yyyy HH:mm")</div></td>
                            <td class="small">@r.purpose</td>
                            <td><partial name="_PrintBadge" model="r.status" /></td>
                            <td class="small text-nowrap">@r.decided_by_name<div class="text-muted">@r.decided_at?.ToString("dd-MMM-yyyy HH:mm")</div></td>
                            <td class="small text-nowrap">@r.return_due_on?.ToString("dd-MMM-yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="small text-muted mt-2 mb-0">Times are UTC.</p>
    </div>
</div>
