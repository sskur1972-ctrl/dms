@using DMS.Model.Account
@model RolesData



<div class="row m-3">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">Delete Role</h4>
            </div>
            <div class="card-body">

                <form id="frmSubmit" onsubmit="return deleteRole()" asp-controller="Roles" asp-action="DeletePost" class="row g-3 needs-validation" novalidate>
                     <div class="card">
                <div class="card-body">
                    <div class="form-row row">
                        <input asp-for="ID" type="hidden" />
                        <div class="form-group col-xl-6  mb-4">
                            <label asp-for="Roles_Name" class="form-label"></label>
                            <input asp-for="Roles_Name" class="form-control alphaspace" disabled required placeholder="Enter Role Name" />
                            <span id="role_name_error" class="text-danger"></span>

                        </div>
                        <div class="col-lg-12">


                                    <div class="col-md-12">
                                        <div class="mb-3">
                                            <label asp-for="objPermissions"></label>

                                            @* Group by Parent Module *@
                                            @{
                                                var groupedByParent = Model.objPermissions
                                                .Where(p => !string.IsNullOrWhiteSpace(p.Parent_module))
                                                .GroupBy(p => p.Parent_module)
                                                .OrderBy(g => g.Key)
                                                .ToList();
                                            }

                                            @foreach (var parentGroup in groupedByParent)
                                            {
                                                <div class="parent-module mb-3">
                                                    <h5><strong>@parentGroup.Key</strong></h5> <!-- Parent Module -->

                                                    @* Group by Sub Module *@
                                                    @{
                                                        var groupedBySub = parentGroup
                                                        .Where(p => !string.IsNullOrWhiteSpace(p.moduleName))
                                                        .GroupBy(p => p.moduleName)
                                                        .OrderBy(g => g.Key)
                                                        .ToList();
                                                    }

                                                    @foreach (var subGroup in groupedBySub)
                                                    {
                                                        <div class="sub-module mb-2" style="margin-left: 20px;">
                                                            <h6 class="text-primary"><strong>@subGroup.Key</strong></h6> <!-- Sub Module -->

                                                            <div class="row">
                                                                @foreach (var permission in subGroup)
                                                                {
                                                                    <div class="col-6">
                                                                        <div class="form-check mb-2">
                                                                            <input class="form-check-input"
                                                                                   type="checkbox"
                                                                                   name="SelectedPermissionIds"
                                                                                   value="@permission.pk_permission"
                                                                                   id="permission_@permission.pk_permission"
                                                                                   disabled
                                                                            @(permission.IsChecked ? "checked" : "") />
                                                                            <label class="form-check-label"
                                                                                   for="permission_@permission.pk_permission">
                                                                                @permission.permission
                                                                            </label>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    }

                                                    @* Handle permissions with no SubModule (optional) *@
                                                    @{
                                                        var noSubModulePermissions = parentGroup
                                                        .Where(p => string.IsNullOrWhiteSpace(p.moduleName))
                                                        .ToList();
                                                    }

                                                    @if (noSubModulePermissions.Any())
                                                    {
                                                        <div class="sub-module mb-2" style="margin-left: 20px;">
                                                            <h6>Other</h6>
                                                            <div class="row">
                                                                @foreach (var permission in noSubModulePermissions)
                                                                {
                                                                    <div class="col-6">
                                                                        <div class="form-check mb-2">
                                                                            <input class="form-check-input"
                                                                                   type="checkbox"
                                                                                   name="SelectedPermissionIds"
                                                                                   value="@permission.pk_permission"
                                                                                   id="permission_@permission.pk_permission"
                                                                                   disabled
                                                                            @(permission.IsChecked ? "checked" : "") />
                                                                            <label class="form-check-label"
                                                                                   for="permission_@permission.pk_permission">
                                                                                @permission.permission
                                                                            </label>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>

                           


                        </div>

                    </div>

                </div>
            </div>
                </form>

                <div class="form-group">
                    <div class="text-end">
                        <input type="button" class="btn btn-primary" onclick="location.href='@Url.Action("Index", "Roles")'" value="Back To List" />

                        <button type="submit" onclick="deleteRole(@Model.ID)" class="btn btn-danger"> Delete</button>
                    </div>
                </div>

               </div>
       </div>
    </div>
</div>

<script>
    function deleteRole(value) {

        Swal.fire({
            title: "Are you sure?",
            text: "Do you want to delete this Role?",
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: "#DD6B55",
            confirmButtonText: "Yes, delete it !!"
        }).then((result) => {
            if (result.value == true) {
                        document.getElementById("frmSubmit").submit();
            }
        });
    }
</script>