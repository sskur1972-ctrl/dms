@* Page title + breadcrumb: ViewData["PageTitle"], ViewData["Section"] (default Administration). *@
@{
    var pageTitle = ViewData["PageTitle"] as string ?? "";
    var sectionName = ViewData["Section"] as string ?? "Administration";
}
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0">@pageTitle</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Dashboards</a></li>
                    <li class="breadcrumb-item">@sectionName</li>
                    <li class="breadcrumb-item active">@pageTitle</li>
                </ol>
            </div>
        </div>
    </div>
</div>
