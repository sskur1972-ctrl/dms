@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.DocumentTitle - Euro-Office Editor</title>
    <style>
        html, body, #eo-placeholder {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #f4f5f7;
        }
    </style>
    <script src="@ViewBag.EuroOfficeServerUrl/web-apps/apps/api/documents/api.js"></script>
</head>
<body>
    <div id="eo-placeholder"></div>
    <script>
        (function () {
            const config = @Html.Raw(ViewBag.EditorConfigJson);
            config.width = "100%";
            config.height = "100%";
            window.docEditor = new DocsAPI.DocEditor("eo-placeholder", config);
        })();
    </script>
</body>
</html>
