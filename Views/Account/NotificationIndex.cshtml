@model List<UserNotificationViewModel>

@using DMS.Model.Account
@using Newtonsoft.Json;
@{
    string username = "";
    List<string> permissions = null;
    string _permissionList = string.Empty;

    string rolename = "";
    string displayname = "";
    string actionName = string.Empty;
    int PermissionCount = 0;
    int VerificationCount = 0;
    List<CurrentUserPermission> deserializedCurrentPermissions = null;

    int storedval = 0;
    int val = 0;
    int rejected = 0;
    int isinitiatior = 0;

}

@{
    try
    {
        @if (User.Identity.IsAuthenticated)
        {
            var claimsCount = User.Claims.Count();

            if (claimsCount > 0)
            {
                // Retrieve the custom claim value from the user's claims
                username = User.Identity.Name;
                displayname = User.Claims.FirstOrDefault(c => c.Type == "displayName")?.Value;
                rolename = User.Claims.FirstOrDefault(c => c.Type == "Roles_Name")?.Value;
                _permissionList = User.Claims.FirstOrDefault(c => c.Type == "serializedPermissionList")?.Value;
                VerificationCount = ViewBag.VerificationCount;
            }
        }

    }
    catch (Exception ex)
    {
        displayname = ex.Message;
    }
}
<partial name="_DataTableCSS" />
<div class="row">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0">Notification</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a asp-controller="Account" asp-action="NotificationIndex">Notification</a></li>

                    <li class="breadcrumb-item active">View Notification</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card" id="leadsList">
            <div class="card-header">
                <h4 class="card-title">Notification</h4>
                <div class="row g-4 align-items-center">
                    <div class="col-sm-auto ms-auto">
                        <div class="hstack gap-2">
                        </div>

                    </div>

                </div>

            </div>


            <div class="card-body">
                <div class="row">
                    <div class="card-body">
                        <table id="FL2FL3List" class="table nowrap dt-responsive align-middle table-hover table-bordered" style="width:100%">
                            <thead class="table-light">
                                <tr>

                                    <th width="20%">@Html.DisplayNameFor(m => m[0].SenderUserName)</th>
                                    <th hidden width="1%">notificationID</th>
                                    <th width="15%">@Html.DisplayNameFor(m => m[0].message)</th>
                                    <th width="20%">@Html.DisplayNameFor(m => m[0].sentDate)</th>
                                    <th width="19%">@Html.DisplayNameFor(m => m[0].is_Viewed)</th>
                                    <th width="5%" class="not-export-col">Action</th>

                                </tr>
                            </thead>
                            <tbody>

                                @foreach (var obj in Model)
                                {

                                    <tr id="notif-row-@obj.notificationID">

                                        <td>@obj.SenderUserName (@obj.SenderRoleName)</td>
                                        <td hidden>@obj.notificationID</td>
                                        <td>@obj.message</td>
                                        <td>@obj.sentDate</td>
                                        <td>
                                            @if (@obj.is_Viewed == 0)
                                            {
                                                <span class="badge bg-warning">Yet to View</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">View</span>
                                            }
                                        </td>
                                        <td>
                                            <div>
                                                <center>
                                                    <div class="dropdown d-inline-block">
                                                        <button class="btn btn-soft-secondary btn-sm dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                            <i class="ri-more-fill align-middle"></i>
                                                        </button>
                                                        <ul class="dropdown-menu">
                                                            <li>
                                                                <a class="dropdown-item btn-view-notification" href="javascript:void(0);" data-notification-id="@obj.notificationID">
                                                                    <i class="ri-eye-fill align-bottom me-2 text-muted"></i>View
                                                                </a>
                                                            </li>
                                                        </ul>
                                                        @*  <ul class="dropdown-menu">
                                                              <li>
                                                                    <a class="dropdown-item" asp-controller="Account" asp-action="NotificationDetailsView" asp-route-id="@obj.notificationID">
                                                                        <i class="ri-eye-fill align-bottom me-2 text-muted"></i>View
                                                                    </a>
                                                              </li>
                                                          

                                                        </ul> *@
                                                    </div>
                                                </center>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!--end row-->
<partial name="_DataTableJS" />

@section scripts {
    <link href="~/assets/css/datatables.bootstrap5.min.css" rel="stylesheet" />
    <link href="~/assets/css/buttons.datatables.min.css" rel="stylesheet" />
    <link href="~/assets/css/responsive.bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" type="text/css" />
    <script src="~/js/download_and_badge.js"></script>
    <script>

        document.addEventListener('DOMContentLoaded', function () {
            window.notificationTable = new DataTable('#FL2FL3List', {
                "pagingType": "full_numbers",
                displayLength: 10,
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'print',
                        exportOptions: {
                            columns: [0, 2, 3, 4, 5]
                        }
                    },
                    {
                        extend: 'excel',
                        exportOptions: {
                            columns: [0, 2, 3, 4, 5]
                        }
                    },
                ],
                 order: [[1, 'desc']]
            });
        });

    </script>



}
