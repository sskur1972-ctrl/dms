@if (TempData["Success"] != null)
{
    <script type="text/javascript">

        document.addEventListener("DOMContentLoaded", function () {
             @* Swal.fire("Hey, Good job !!", "You clicked the button !!", "success"); *@

            debugger
            var Msg = '@TempData["Success"]';
            var Valid = '@TempData["Valid"]';

            if (Msg != "") {

                if(Valid == "1") {
                    

                    Swal.fire("", Msg, "success");

                } else if (Valid == "0") {
                    Swal.fire("", Msg, "error");
                } else if (Valid == "-1") {
                    Swal.fire({
                        title: "",
                        html: Msg,
                        type: "error",
                        button: "Ok",
                    })

                    Swal.fire({
                        type: "error",
                        title: "Oops...",
                        text: Msg,
                        button: "Ok",

                    });
                }

            }
        });
    </script>
} 