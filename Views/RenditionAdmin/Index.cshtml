@using DMS.Model.Documents
@model List<RenditionJobRow>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["PageTitle"] = "PDF Rendition";
    ViewData["Section"] = "Administration";
    var c = (DMS.Web.Services.Rendition.ConverterStatus)ViewBag.converter;
    string Badge(string? s) => s switch { "DONE" => "bg-success", "FAILED" => "bg-danger", "RUNNING" => "bg-info", _ => "bg-warning" };
}
<partial name="_AdminPageTitle" />

<div class="card">
    <div class="card-header d-flex align-items-center">
        <h5 class="card-title mb-0 flex-grow-1">Converter</h5>
        <form asp-action="RunNow" method="post"><button class="btn btn-sm btn-soft-primary" type="submit">Process the queue now</button></form>
    </div>
    <div class="card-body">
        <div class="alert @(c.IsAvailable ? "alert-success" : "alert-warning") mb-2">
            <strong>@(c.IsAvailable ? "LibreOffice is available" : "No converter")</strong>@(c.IsAvailable ? "" : " - " + c.Message)
            @if (c.Path != null) { <div class="small font-monospace">@c.Path @c.Version</div> }
        </div>
        <p class="small text-muted mb-0">
            Word, Excel and PowerPoint files are converted with LibreOffice (System Configuration: <code>rendition.libreOfficePath</code>,
            <code>rendition.timeoutSeconds</code>); an uploaded PDF is used as it is. Every controlled copy is then stamped by the application:
            the state watermark, a footer on every page and the signature page (<code>rendition.signaturePage</code>).
            A state that requires a rendition (Approved, Published, Effective - Workflow Configuration → States) waits for it
            (<code>rendition.requireBeforePublication</code>). Without LibreOffice, QA attaches the PDF by hand on the document page.
        </p>
    </div>
</div>

<div class="card">
    <div class="card-header"><h5 class="card-title mb-0">Jobs</h5></div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm table-bordered align-middle mb-0">
                <thead class="table-light"><tr><th>#</th><th>Document</th><th>Rev</th><th>For state</th><th>Status</th><th>Attempts</th><th>Requested</th><th>Finished</th><th>Error</th><th></th></tr></thead>
                <tbody>
                    @foreach (var j in Model)
                    {
                        <tr>
                            <td>@j.id</td>
                            <td><a asp-controller="Documents" asp-action="Details" asp-route-id="@j.document_id">@j.document_number</a></td>
                            <td>@j.version_label</td><td>@j.state_code</td>
                            <td><span class="badge @Badge(j.status)">@j.status</span></td>
                            <td>@j.attempts / @j.max_attempts</td>
                            <td class="text-nowrap">@j.requested_at.ToString("dd-MMM HH:mm") @j.requested_by_name</td>
                            <td class="text-nowrap">@j.finished_at?.ToString("dd-MMM HH:mm")</td>
                            <td class="small">@j.last_error</td>
                            <td>@if (j.status == "FAILED") { <form asp-action="Retry" method="post"><input type="hidden" name="id" value="@j.id" /><button class="btn btn-sm btn-light" type="submit">Retry</button></form> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
